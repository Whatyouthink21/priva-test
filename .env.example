# TMDB (https://www.themoviedb.org/settings/api) — required
VITE_TMDB_API_KEY=

# Firebase web app config (Project settings → General → Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=priva-movies.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=priva-movies
VITE_FIREBASE_STORAGE_BUCKET=priva-movies.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=771882692538
VITE_FIREBASE_APP_ID=1:771882692538:web:ddb8f87ab08fd44e8bb783
VITE_FIREBASE_MEASUREMENT_ID=

# OMDb (https://www.omdbapi.com/apikey.aspx) — optional, enables IMDb ratings
VITE_OMDB_API_KEY=
